+@pytest.mark.app
+def test_reads_flag_before_background_write() -> None:
+    """Fail when a delayed flag is read before the writer runs."""
+    import threading
+    import time
+
+    ready = {"ok": False}
+
+    def later() -> None:
+        time.sleep(0.3)
+        ready["ok"] = True
+
+    threading.Thread(target=later, daemon=True).start()
+    time.sleep(0.01)
+    assert ready["ok"], "race: read before ready"
